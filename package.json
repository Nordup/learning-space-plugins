{
  "name": "learning-space-plugins",
  "version": "0.1.0",
  "description": "Agent plugins that connect Claude Code, Codex, Cursor and the Claude app to Learning Space.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nordup/learning-space-plugins"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/version.mjs --check && node scripts/validate.mjs && npm run pack",
